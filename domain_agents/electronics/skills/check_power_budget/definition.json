{
  "name": "check_power_budget",
  "version": "0.1.0",
  "domain": "electronics",
  "agent": "electronics",
  "description": "Check a design's power budget: verify the supply rails can meet the aggregate load with margin, and flag any rail that is over budget.",
  "phase": 1,
  "tools_required": [
    {
      "tool_id": "power.check_budget",
      "capability": "power_budget",
      "required": true
    }
  ],
  "timeout_seconds": 30,
  "retries": 0,
  "idempotent": true,
  "tags": [
    "power",
    "budget",
    "rails",
    "electronics",
    "validation"
  ],
  "input_schema": "schema.CheckPowerBudgetInput",
  "output_schema": "schema.CheckPowerBudgetOutput"
}
