{
  "name": "generate_cad_ir",
  "version": "0.1.0",
  "domain": "mechanical",
  "agent": "mechanical",
  "description": "Generate CAD geometry from a Design IR document by lowering it via the freecad or cadquery adapter. Each entity's `op` picks its exact required fields (see the entities schema for the full per-op list) -- common ops: create_body, sketch (body_ref, elements: line/circle/rectangle/arc), pad/pocket (body_ref, sketch_ref, depth), revolve (body_ref, sketch_ref, axis, angle), fillet_edges/chamfer_edges (body_ref, radius/distance, edge_selectors), shell (body_ref, thickness), boolean (operation, base_ref, tool_refs), linear_pattern/polar_pattern (body_ref, source_ref, count). There is no extrude/cut/hollow/circle_pattern op -- use pad/boolean-subtract/shell/polar_pattern instead.",
  "phase": 1,
  "tools_required": [
    { "tool_id": "cadquery.execute_script", "capability": "cad_script", "required": false },
    { "tool_id": "freecad.open_session", "capability": "cad_session", "required": true },
    { "tool_id": "freecad.close_session", "capability": "cad_session", "required": true },
    { "tool_id": "freecad.create_body", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.create_primitive", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.create_sketch", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.pad_sketch", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.pocket_sketch", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.revolve_sketch", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.loft_sketches", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.sweep_sketch", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.fillet_edges", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.chamfer_edges", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.linear_pattern", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.polar_pattern", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.mirror_feature", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.shell_solid", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.boolean", "capability": "cad_boolean", "required": false },
    { "tool_id": "freecad.fillet", "capability": "cad_fillet", "required": false },
    { "tool_id": "freecad.chamfer", "capability": "cad_chamfer", "required": false },
    { "tool_id": "freecad.transform_object", "capability": "cad_author", "required": false },
    { "tool_id": "freecad.create_assembly", "capability": "cad_assembly", "required": false },
    { "tool_id": "freecad.add_part_to_assembly", "capability": "cad_assembly", "required": false },
    { "tool_id": "freecad.add_assembly_joint", "capability": "cad_assembly", "required": false },
    { "tool_id": "freecad.measure", "capability": "cad_inspect", "required": true },
    { "tool_id": "freecad.export_model", "capability": "cad_export", "required": true },
    { "tool_id": "twin.commit_geometry", "capability": "twin_geometry", "required": false }
  ],
  "input_schema": "schema.GenerateCadIrInput",
  "output_schema": "schema.GenerateCadIrOutput",
  "timeout_seconds": 300,
  "retries": 1,
  "idempotent": true,
  "tags": ["cad", "freecad", "cadquery", "design-ir", "feature-tree", "generation", "llm"]
}
