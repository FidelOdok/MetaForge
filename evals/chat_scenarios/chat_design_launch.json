{
  "id": "chat_design_launch",
  "title": "Chat-triggered design flow end-to-end: launch, gate approval, post-approval status",
  "scope": "project",
  "rubric": [
    "chat_tooluse"
  ],
  "variants": [
    {
      "name": "native",
      "provider": null,
      "model": null
    }
  ],
  "max_turn_seconds": 420,
  "turns": [
    {
      "say": "Kick off the full hardware design lifecycle for this project now: a pocket-size USB-C powered soldering-iron controller with an OLED readout. Start the run and tell me the run id.",
      "checks": [
        {
          "id": "launch_tool_called",
          "type": "tool_called",
          "tool": "mcp_run_start_design_flow"
        },
        {
          "id": "launch_scoped_to_project",
          "type": "tool_arg_equals",
          "tool": "mcp_run_start_design_flow",
          "arg": "project_id",
          "value": "$PROJECT_ID"
        },
        {
          "id": "launch_replied",
          "type": "reply_is_not_fallback"
        }
      ]
    },
    {
      "say": "What's the status of that run right now?",
      "checks": [
        {
          "id": "status_tool_called",
          "type": "tool_called",
          "tool": "mcp_run_get_status"
        },
        {
          "id": "status_replied",
          "type": "reply_is_not_fallback"
        }
      ]
    },
    {
      "gateway_action": "approve_run",
      "checks": [
        {
          "id": "gate1_approved",
          "type": "action_succeeded"
        }
      ]
    },
    {
      "say": "The first gate was just approved by the reviewer. What phase is the run in now?",
      "checks": [
        {
          "id": "post_approval_status_tool",
          "type": "tool_called",
          "tool": "mcp_run_get_status"
        },
        {
          "id": "post_approval_replied",
          "type": "reply_is_not_fallback"
        }
      ]
    }
  ],
  "project_description": "Pocket-size USB-C soldering-iron controller with OLED readout"
}
