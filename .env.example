# MetaForge: environment variables for docker compose
# Copy to .env and customize as needed:  cp .env.example .env
#
# Every variable docker-compose*.yml reads is listed here, and
# tests/unit/test_env_example.py fails CI when one is missing.
#
# Lines left as `NAME=` are ones you are expected to fill (or that
# scripts/install.sh fills for you). Lines commented out as `# NAME=value`
# show the compose default: uncomment only to change it.
#
# After editing .env, recreate the services that read it, e.g.
#   docker compose up -d gateway mcp-http

# ── Dashboard ────────────────────────────────────────────────────
DASHBOARD_PORT=3000
# METAFORGE_DASHBOARD_TAG=latest

# ── Gateway ───────────────────────────────────────────────────────
GATEWAY_PORT=8000
METAFORGE_ENV=docker
# Image tag docker-compose.yml pulls from ghcr.io/fidelodok/metaforge-gateway
# (MET-638). Leave at "latest", or pin a released version (e.g. v0.4.2).
METAFORGE_GATEWAY_TAG=latest
# URL clients actually use to reach this gateway. Set it on any shared box:
# unset, the chat model has no host to anchor a link to and invents one.
METAFORGE_PUBLIC_URL=
# Exit instead of serving an empty in-memory twin when Neo4j is down, so
# `restart: unless-stopped` retries until it is up.
# METAFORGE_REQUIRE_NEO4J=true
# Approval policy (FORGE-726): the strongest mode any project may choose for
# its design-flow gates (off, advise, auto_clean, auto).
# METAFORGE_AUTO_APPROVE_MAX=advise
# Let an agent decide human-authority items and the Imagine handover on your
# behalf, recorded as the agent acting for you (default false).
# METAFORGE_ALLOW_AGENT_HUMAN_AUTHORITY=false
# Held tool writes (FORGE-780): how long a held call's approval stays open
# for the identical retry, in seconds (max 3600).
# METAFORGE_TOOL_APPROVAL_TTL_S=1800
# Spend cap on policy auto-approval of paid tools, per project per hour.
# METAFORGE_AUTO_APPROVE_IMAGE_PER_HOUR=20
# METAFORGE_AUTO_APPROVE_MESH_PER_HOUR=3
# METAFORGE_AUTO_APPROVE_CAD_LOOP_PER_HOUR=3
# Cap on policy auto-approval of cadquery.execute_script (isolated runner), per project per hour.
# METAFORGE_AUTO_APPROVE_SCRIPT_PER_HOUR=60
# One CAD design loop run's priced model spend limit, USD (calls are capped too).
# METAFORGE_CAD_LOOP_MAX_SPEND_USD=1.0
# How long a gate review waits for a client reviewer before falling back (s).
# METAFORGE_CLIENT_REVIEW_WAIT_SECONDS=600
# Durable runs ledger (SQLite). Path defaults to ~/.metaforge/runs_ledger.db
# in the container; `on` keeps runs process-local (ephemeral CI).
# METAFORGE_RUNS_LEDGER_PATH=
# METAFORGE_RUNS_LEDGER_DISABLE=off
# Durable operation event log behind the project operation stream (FORGE-785,
# SQLite). Defaults to ~/.metaforge/operations.db on the metaforge-home volume;
# skipped (in memory) with the runs ledger when _DISABLE is on. Events older
# than the retention window are pruned (0 keeps everything).
# METAFORGE_OPERATIONS_PATH=
# METAFORGE_OPERATIONS_RETENTION_DAYS=14

# Credentials below are deliberately EMPTY, and compose refuses to start the
# service that needs one rather than choosing for you (FORGE-556, FORGE-558).
# They used to ship with working defaults (`metaforge`, `minioadmin`), which
# meant every install shared a password printed in a public repository.
#
# The default here was also what broke the fix that already existed:
# scripts/install.sh generates secrets with set_if_blank, which skips any
# key that ALREADY HAS A VALUE. Shipping one guaranteed the generator never
# fired. Leaving them blank is what makes it work.
#
#   scripts/install.sh             # fills every blank below
#   openssl rand -base64 24        # or set them yourself

# ── Neo4j ─────────────────────────────────────────────────────────
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Postgres ──────────────────────────────────────────────────────
# The user and database name are identifiers, not secrets, and keep their
# compose defaults. Only the password has none.
POSTGRES_PASSWORD=
# POSTGRES_USER=metaforge
# POSTGRES_DB=metaforge
# POSTGRES_PORT=5432
# Full connection string for the gateway, sidecar and worker. Built from the
# POSTGRES_* values above when unset; set it only for an external database.
# DATABASE_URL=postgresql+asyncpg://metaforge:<password>@postgres:5432/metaforge

# ── Object store (work-product blob storage, S3) ──────────────────
# The `object-store` service (SeaweedFS since FORGE-577; the variables keep
# their MINIO_ names). MINIO_ACCESS_KEY identifies the account and keeps its
# default; the secret key is the credential.
MINIO_SECRET_KEY=
# MINIO_ACCESS_KEY=minioadmin
# MINIO_ENDPOINT=minio:9000
# MINIO_BUCKET=metaforge-kb
# MINIO_SECURE=false
# MINIO_API_PORT=9000
# METAFORGE_SEAWEEDFS_TAG=4.48

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_PORT=9092

# ── Temporal ──────────────────────────────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
# Temporal's own Postgres. Not published to the host, but it was hardcoded as
# `temporal` on both sides, so every install shared it.
TEMPORAL_POSTGRES_PASSWORD=

# ── Observability (only used with --profile observability) ────────
# Grafana's admin password. Deliberately EMPTY, and compose refuses to start
# Grafana without it (FORGE-556). It used to ship as `metaforge`, which every
# install shared, and which stopped install.sh's set_if_blank from replacing
# it. Leave it blank and run scripts/install.sh, or set your own:
#   GRAFANA_PASSWORD=$(openssl rand -base64 24)
GRAFANA_PASSWORD=

# ── Gateway authentication ────────────────────────────────────────
# Leave METAFORGE_AUTH_MODE unset (or `off`) for a local single-user
# gateway: behaviour is identical to every release before this existed.
#
# Set it to the name of an installed authentication provider and the
# gateway requires a bearer token on every route except /health and the
# API docs. Providers are plug-ins registered on the `metaforge.auth`
# entry-point group and are installed alongside the gateway; this
# repository ships none, so `off` is the only value that works out of
# the box. See docs/deployment/authentication.md.
#
# Naming a provider that is not installed REFUSES TO START rather than
# coming up silently open. Confirm a running gateway with:
#   curl -s http://localhost:8000/health | jq .auth_mode
METAFORGE_AUTH_MODE=off
# Exact browser origins allowed to call the gateway, comma-separated. A
# wildcard is REFUSED when auth is on: `*` plus credentials would let any
# site call this gateway with a signed-in user's token.
METAFORGE_CORS_ORIGINS=
# Each provider reads its own settings from this environment; see that
# provider's documentation for the variables it expects.

# Guards the routes that store AI provider keys and pick the active model
# (POST/DELETE /v1/harness/credentials, PUT /v1/harness/selection): the
# dashboard's Settings page, `forge auth login` / `use` / `logout`.
# Callers send it as the X-MetaForge-Admin header. Unset, those routes accept
# only direct requests from the gateway's own machine, so the dashboard (which
# reaches the gateway through its proxy) needs it. install.sh generates one.
METAFORGE_HARNESS_ADMIN_TOKEN=

# ── AI model for chat and agents ──────────────────────────────────
# Provider id from the harness registry (openai, anthropic, openrouter,
# ollama, ...) and its model. A provider and model picked in the dashboard
# override these.
METAFORGE_LLM_PROVIDER=
METAFORGE_LLM_MODEL=
METAFORGE_LLM_API_KEY=
# Only for OpenAI-compatible or self-hosted endpoints.
METAFORGE_LLM_BASE_URL=
# Route chat through the harness (the full provider registry). `off` keeps
# the legacy openai/anthropic-only path.
# METAFORGE_CHAT_HARNESS=off
# Expose skill-layer tools (generate_cad_ir, ...) to the harness loop.
# Newer code that touches the twin directly, so separately toggleable.
# METAFORGE_CHAT_SKILLS=off
# Per-turn limits. Unset means unbounded.
# METAFORGE_CHAT_MAX_COST_USD=
# METAFORGE_CHAT_MAX_STEPS=
# METAFORGE_CHAT_WALL_CLOCK_SECONDS=
# How the harness spreads calls across configured keys for one provider.
# METAFORGE_ROTATION_STRATEGY=round_robin

# ── Knowledge + component search (MET-335, MET-436) ───────────────
# OpenRouter key powers knowledge.extract's Tier-2/3 property inference
# and component.search_intent's NL-to-spec translation. Leave empty to
# run Tier-1-only extraction and disable component.search_intent.
OPEN_ROUTER_API_KEY=
# AI concept images (twin.render_concept_image). Off unless set; each image is a paid call.
# openrouter uses the OpenRouter key above; openai uses OPENAI_API_KEY.
# METAFORGE_IMAGE_PROVIDER=
# Model slug (default google/gemini-2.5-flash-image on openrouter, gpt-image-1 on openai).
# METAFORGE_IMAGE_MODEL=
# Seconds before an image request is abandoned (default 120).
# METAFORGE_IMAGE_TIMEOUT_S=
# AI 3D reference meshes from a concept image (twin.generate_concept_mesh), for
# concept review only. Off unless set to tripo; each mesh is a paid Tripo call.
# A key alone does not turn it on.
# METAFORGE_MESH_PROVIDER=
# Tripo API key (platform.tripo3d.ai), used only when the provider is tripo.
# TRIPO_API_KEY=
# Total seconds a mesh may take, upload to download (default 600).
# METAFORGE_MESH_TIMEOUT_S=
# Tripo's model (default v3.1-20260211).
# METAFORGE_MESH_MODEL_VERSION=
# Slow tool calls (a concept mesh) return a job the client polls with
# twin.job_status. Each process keeps its own SQLite store of jobs, and opening
# it marks jobs left running by an earlier run as interrupted. The gateway's
# store (default ~/.metaforge/tool_jobs.db, on the metaforge-home volume):
# METAFORGE_TOOL_JOBS_PATH=
# The MCP sidecar's store (default /var/lib/metaforge/jobs/tool_jobs.db, on the
# mcp-tool-jobs volume). Give each process its own file, never one shared path.
# METAFORGE_MCP_TOOL_JOBS_PATH=
# Model for the gate reviewer when the project's approval policy names none
# (its reviewer_model wins). "provider:model", or a bare model id for the
# chat provider. Unset, the reviewer uses the chat model (METAFORGE_LLM_MODEL).
# METAFORGE_REVIEWER_MODEL=
# Model for vision calls (reading sketches), a model id for the chat provider
# (on OpenRouter a vendor/model slug). Unset, vision uses the chat model.
# METAFORGE_VISION_MODEL=
# Model overrides for those OpenRouter calls; unset uses in-code defaults.
# LIGHTRAG_MODEL=
# LIGHTRAG_FALLBACK_MODEL=
# PROPERTY_EXTRACTION_MODEL=
# Models for the knowledge consolidation worker. Leave unset and the
# validator rejects every insight, so set them if you run consolidation.
# CONSOLIDATION_MODEL=
# CONSOLIDATION_FALLBACK_MODEL=

# ── LightRAG knowledge UI ─────────────────────────────────────────
# Leave LIGHTRAG_API_KEY unset for local dev (no token); set it to lock
# down the UI.
LIGHTRAG_API_KEY=
# LIGHTRAG_UI_PORT=9621
# Defaults run a local Ollama with llama3.2:3b (about 2 GB on first start).
# For Gemini: LIGHTRAG_LLM_BINDING=gemini plus LIGHTRAG_LLM_API_KEY, and
# leave LIGHTRAG_LLM_HOST blank.
LIGHTRAG_LLM_API_KEY=
# LIGHTRAG_LLM_BINDING=ollama
# LIGHTRAG_LLM_HOST=http://lightrag-ui-ollama:11434
# LIGHTRAG_LLM_MODEL=llama3.2:3b
LIGHTRAG_EMBEDDING_API_KEY=
# LIGHTRAG_EMBEDDING_BINDING=ollama
# LIGHTRAG_EMBEDDING_HOST=http://lightrag-ui-ollama:11434
# LIGHTRAG_EMBEDDING_MODEL=nomic-embed-text
# LIGHTRAG_EMBEDDING_DIM=768

# ── Component sourcing ────────────────────────────────────────────
# Distributor adapters (digikey/mouser/nexar) + distributors.resolve_offers.
# Each adapter self-disables (skips with "missing env vars") when its own
# credentials are absent: set only the ones you have.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Sandbox vs production API host.
# DIGIKEY_BASE_URL=
MOUSER_API_KEY=
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# FORGE-613: Farnell (element14) prices in its store's currency; uk.farnell.com is GBP.
FARNELL_API_KEY=
FARNELL_STORE=uk.farnell.com
ARROW_LOGIN=
ARROW_API_KEY=
# Mouser counts real calls against this per UTC day and caches answers.
MOUSER_DAILY_LIMIT=1000

# ── Web search (MET-7) ────────────────────────────────────────────
# Brave Search API key, https://brave.com/search/api/ (free tier:
# 1 req/s, 2000 queries/month). Without this, web.search / web.fetch
# are NOT registered, so agents never see a tool that cannot work.
BRAVE_API_KEY=

# ── Cloud adapters: API services in place of local tool containers ─
# Meshy AI (https://www.meshy.ai/api): text or image to 3D mesh. Each
# meshy.text_to_3d / image_to_3d / refine_texture call spends account
# credits. Without this key, meshy.* is NOT registered. MESHY_BASE_URL
# overrides the API host (proxy, tests).
MESHY_API_KEY=
# Zoo (https://zoo.dev/docs/developer-tools/api): converts native CAD
# (SolidWorks, CATIA, NX, Creo, Inventor, Parasolid, ACIS) and meshes to STEP,
# STL, GLB and more, and measures volume, mass and centre of mass. Each call
# uploads the file to Zoo and uses the account's API credits. Without this
# token, zoo.* is NOT registered. ZOO_BASE_URL overrides the API host.
ZOO_API_TOKEN=
# Tripo AI (https://developers.tripo3d.com): text or image to 3D mesh, and
# mesh conversion to STL / 3MF. Each tripo.text_to_3d / image_to_3d / convert
# call spends account credits (refunded if the job fails). Without this key,
# tripo.* is NOT registered.
TRIPO_API_KEY=
# Tripo keys are region-bound. Blank uses the global host; a China-region key
# needs https://openapi.tripo3d.com/v3.
# TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
# Slant 3D (https://slant3dapi.com): uploads an STL to the Slant 3D print
# farm for its slicing estimate (weight, print time, supports) and a USD
# quote. Free to call and places no order. Without this key, slant3d.* is NOT
# registered.
SLANT3D_API_KEY=
# The Slant 3D platform new files belong to. Blank uses the account's first.
# SLANT3D_PLATFORM_ID=

# ── MCP HTTP sidecar ──────────────────────────────────────────────
# Static API key guarding the HTTP MCP transport (MET-338). Leave empty
# for LAN-only open mode; set a strong value before exposing :8765 via
# the Cloudflare tunnel below. Clients send it as `Authorization: Bearer`.
# Works for Claude Code; the claude.ai web connector needs OAuth (below).
METAFORGE_MCP_API_KEY=
# Extra browser origins allowed to call /mcp, comma-separated (FORGE-604).
# Loopback, claude.ai/claude.com and the issuer are always allowed.
METAFORGE_MCP_ALLOWED_ORIGINS=
# Signs the state carried by questions to 2026-07-28 clients (FORGE-601).
# Unset, a random per-process key is used and an open question is asked
# again after a restart.
METAFORGE_MCP_STATE_KEY=
# `off` stops serving MCP revision 2026-07-28 (rollback, FORGE-592).
# METAFORGE_MCP_MODERN=

# ── MCP OAuth 2.1 + PKCE (MET-480) ────────────────────────────────
# Required for the claude.ai web connector, which can't send a static
# bearer header. Setting METAFORGE_OAUTH_LOGIN_SECRET turns the OAuth
# authorization server ON; /authorize is gated by this shared secret.
# Leave empty to keep OAuth off (Claude Code + static key still work).
METAFORGE_OAUTH_LOGIN_SECRET=
# Public HTTPS base URL claude.ai reaches the server at, e.g.
# https://mcp.yourdomain.com. If unset, it's derived from the
# X-Forwarded-* headers Cloudflare sets: set it explicitly if discovery
# misbehaves behind other proxies.
METAFORGE_OAUTH_ISSUER=
# Optional: actor id stamped on issued tokens (default oauth:web) and
# token lifetimes in seconds (defaults: access 3600, refresh 30d).
# METAFORGE_OAUTH_ACTOR_ID=oauth:web
# METAFORGE_OAUTH_ACCESS_TTL=3600

# ── Cloudflare tunnel (MET-482) ───────────────────────────────────
# Token for the named tunnel that fronts mcp-http and gives Claude cloud
# a stable public HTTPS endpoint. Create the tunnel in the Cloudflare
# Zero Trust dashboard (Networks > Tunnels) and paste its token here.
# Route the tunnel's Public Hostname to HTTP http://mcp-http:8765.
# See docs/runbooks/cloudflare-mcp-tunnel.md.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Service-to-service wiring (worker, sidecar) ───────────────────
# Key the sidecar presents when it posts back to the gateway (FORGE-647).
# Leave empty on a gateway with no key.
METAFORGE_GATEWAY_API_KEY=
# How the sidecar recognises the run worker as a trusted service caller.
# Unset, the worker's writes are held like any untrusted caller's.
METAFORGE_MCP_SERVICE_KEY=
# Where the worker announces open gates and gets its tools.
# METAFORGE_GATEWAY_URL=http://gateway:8000
# METAFORGE_MCP_URL=http://mcp-http:8765/mcp
# Container watchdog.
# METAFORGE_WATCHDOG_INTERVAL=30
# METAFORGE_WATCHDOG_MAX_RESTARTS_PER_HOUR=3
# METAFORGE_WATCHDOG_MEMORY_WARN_MB=512

# ── Tool adapter containers ───────────────────────────────────────
# Image tag for the adapter images (OCCT, CalculiX, ...).
# METAFORGE_ADAPTER_TAG=latest
# OCCT_PORT=8100
# CALCULIX_PORT=8200
# FREECAD_MAX_SESSIONS=32
# FREECAD_SESSION_TTL_SECONDS=1800
# OPENFOAM_MAX_CELLS=2000000
# OPENFOAM_MAX_PROCS=8
# OPENFOAM_MAX_OPERATION_TIME=3600
# FIRMWARE_MAX_BUILD_TIME=600
# FIRMWARE_MAX_EMULATION_TIME=120
# Longest a single PrusaSlicer run may take, seconds.
# SLICER_MAX_OPERATION_TIME=600
# Longest a single model view render in the render adapter, seconds.
# RENDER_MAX_OPERATION_TIME=120
# cadquery.execute_script runner (FORGE-832): the memory each isolated script
# child may really use, in MB (RLIMIT_DATA, not address space), and how many
# children run at once. The cadquery-adapter's 6G limit is sized for the
# defaults; raise it with either.
# CADQUERY_RUNNER_MEMORY_MB=2048
# CADQUERY_RUNNER_MAX_CONCURRENT=2
